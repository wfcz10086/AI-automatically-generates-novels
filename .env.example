# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不会进仓库。
#
# 每个网关两项：地址 + 密钥。不用的网关留空即可，注册表会自动跳过。

# 主力自建网关（推荐）
NOVEL_GW1_URL=http://your-vllm-host:8000/v1
NOVEL_GW1_KEY=EMPTY
NOVEL_GW1_MODEL=Qwen3.8-Flash-Next

# 备用自建网关
NOVEL_GW2_URL=
NOVEL_GW2_KEY=
NOVEL_GW2_MODEL=

# 商用聚合网关（可选，一个入口挂多家模型）
NOVEL_GW3_URL=
NOVEL_GW3_KEY=
NOVEL_GW3_MODEL=

# 服务端口
NOVEL_PORT=60001

# 自带 SearXNG 的密钥（docker compose 用；本机自用随便填）
SEARXNG_SECRET=change-me-local-only
# 检索地址：docker compose 下自动指向自带的 searxng；裸跑时改成你自己的
NOVEL_SEARCH_URL=http://127.0.0.1:18888

# 访问密码。留空 = 不启用鉴权（仅限本机自用）。
# 服务绑 0.0.0.0，公网可达时务必设置，否则任何人都能进来调你的模型。
NOVEL_PASSWORD=
NOVEL_SECRET=
